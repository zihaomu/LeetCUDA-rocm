ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm/bin/hipcc

cflags = -DTORCH_EXTENSION_NAME=leetcuda_rocm_flash_swizzle_candidate_5c0a010d03004bd6 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /opt/venv/lib/python3.13/site-packages/torch/include -isystem /opt/venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.13/site-packages/torch/include/THH -isystem /opt/rocm/include -isystem /opt/python/cpython-3.13.13-linux-x86_64-gnu/include/python3.13 -fPIC -std=c++20 -O3 -std=c++20
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC
cuda_cflags = -DWITH_HIP -DTORCH_EXTENSION_NAME=leetcuda_rocm_flash_swizzle_candidate_5c0a010d03004bd6 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /opt/venv/lib/python3.13/site-packages/torch/include -isystem /opt/venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.13/site-packages/torch/include/THH -isystem /opt/rocm/include -isystem /opt/python/cpython-3.13.13-linux-x86_64-gnu/include/python3.13 -O3 -std=c++20 -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 -std=c++20 --offload-arch=gfx1201 -fno-gpu-rdc -O3 -std=c++20 -DLEETCUDA_ROCM=1 -U__HIP_NO_HALF_OPERATORS__ -U__HIP_NO_HALF_CONVERSIONS__
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/opt/venv/lib/python3.13/site-packages/torch/lib -lc10 -lc10_hip -ltorch_cpu -ltorch_hip -ltorch -ltorch_python -L/opt/rocm/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build flash_swizzle_candidate.cuda.o: cuda_compile /home/zihaomu/zihaomu_workspace/leetcuda_workspace/LeetCUDA/.cache/rocm10/59fd7d638c6f8c646bbe/torch/flash_swizzle_candidate_5c0a010d03004bd6/flash_swizzle_candidate.hip





build leetcuda_rocm_flash_swizzle_candidate_5c0a010d03004bd6.so: link flash_swizzle_candidate.cuda.o

default leetcuda_rocm_flash_swizzle_candidate_5c0a010d03004bd6.so
